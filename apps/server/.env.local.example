# Para probar en tu compu: copiá este archivo como apps/server/.env
# Base que levanta `npm run db` (docker-compose.yml)
DATABASE_URL=postgres://scout:scout@localhost:5432/scouttracker
PORT=3000
# Dirección con la que el celular llega al servidor: la del túnel (https://...trycloudflare.com)
# o la IP de la compu en la red Wi-Fi (http://192.168.0.10:3000). Se usa en los enlaces de los mails.
URL_PUBLICA=http://localhost:3000
DIR_ALMACENAMIENTO=./almacenamiento
