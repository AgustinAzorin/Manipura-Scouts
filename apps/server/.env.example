# Copiar a .env (no se versiona) y completar.
DATABASE_URL=postgres://usuario:clave@host:5432/scouttracker
PORT=3000
# URL pública del servidor: se usa en los enlaces de los mails (activación y recuperación).
URL_PUBLICA=https://api.ejemplo.com.ar
# Al menos 32 caracteres aleatorios. Firma los enlaces temporales de archivos (RNF-022).
SECRETO_ENLACES=
# Directorio privado para adjuntos y logos (no debe servirse como estático).
DIR_ALMACENAMIENTO=/var/lib/scouttracker/archivos
# Sin RESEND_API_KEY los mails se escriben en el log del servidor.
RESEND_API_KEY=
MAIL_REMITENTE=ScoutTracker <no-responder@ejemplo.com.ar>
# RNF-034: a quién avisar los errores nuevos del servidor.
MAIL_RESPONSABLE_TECNICO=
# RF-080: los avisos push salen por el servicio de Expo. El token es opcional (lo da expo.dev →
# Access tokens) y solo hace falta si se activa "Enhanced push security" en el proyecto.
EXPO_ACCESS_TOKEN=
# Solo para la versión web de desarrollo de la app.
ORIGENES_CORS=
NODE_ENV=production
