# Copiá este archivo como deploy/.env (no se versiona) y completalo. Ver docs/desplegar.md.
# Los comentarios van en su propia línea, y los valores sin comillas.

# Dominio que apunta a este servidor; Caddy saca el certificado HTTPS para él.
DOMINIO=api.tudominio.com.ar
URL_PUBLICA=https://api.tudominio.com.ar

# Supabase → Connect → Session pooler. Sin "?sslmode=..." al final: el SSL lo maneja DATABASE_SSL_CA.
DATABASE_URL=postgresql://postgres.REFERENCIA:CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Solo si la verificación del certificado de Supabase falla (ver la guía): cifra sin verificar.
# DATABASE_SSL=sin-verificar
# DATABASE_SSL_CA_CONTENEDOR=

# 64 caracteres aleatorios: openssl rand -hex 32
SECRETO_ENLACES=

# Mails (invitaciones y recuperación). Sin RESEND_API_KEY los enlaces quedan en el log del servidor.
RESEND_API_KEY=
MAIL_REMITENTE=ScoutTracker <no-responder@tudominio.com.ar>
# A quién avisar los errores del servidor (RNF-034).
MAIL_RESPONSABLE_TECNICO=

# Backups (deploy/backup.sh): destino de rclone para la copia fuera del servidor, por ejemplo
# gdrive:scouttracker-backups. Vacío = solo copia local.
BACKUP_REMOTO=
